+<script>
+  // Dynamic quick calculation for PO creation
+  const qtyInput = document.getElementById('po-qty');
+  const priceInput = document.getElementById('po-unit-price');
+  const totalPreview = document.getElementById('po-total-preview');
+  const materialSelect = document.getElementById('po-material-select');
+
+  function updatePOTotal() {
+    if (!qtyInput || !priceInput || !totalPreview) return;
+    const qty = parseFloat(qtyInput.value) || 0;
+    const price = parseFloat(priceInput.value) || 0;
+    const total = qty * price;
+    totalPreview.textContent = total.toLocaleString('vi-VN') + 'Ä‘';
+  }
+
+  if (qtyInput) qtyInput.addEventListener('input', updatePOTotal);
+  if (priceInput) priceInput.addEventListener('input', updatePOTotal);
+
+  function openImportModal(code, name, defaultQty) {
+    if (materialSelect) {
+      let optionFound = false;
+      for (let i = 0; i < materialSelect.options.length; i++) {
+        if (materialSelect.options[i].value === code) {
+          materialSelect.selectedIndex = i;
+          optionFound = true;
+          break;
+        }
+      }
+      if (!optionFound) {
+        materialSelect.options[0].text = code + ' - ' + name;
+        materialSelect.selectedIndex = 0;
+      }
+    }
+    if (qtyInput) qtyInput.value = defaultQty;
+    if (code === 'NL-002') {
+      if (priceInput) priceInput.value = 22800;
+    } else if (code === 'NL-001') {
+      if (priceInput) priceInput.value = 170000;
+    } else {
+      if (priceInput) priceInput.value = 35000;
+    }
+    updatePOTotal();
+    
+    // Smooth scroll down to stock in form
+    const stockForm = document.getElementById('form-stock-in');
+    if (stockForm) {
+      stockForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      stockForm.classList.add('ring-2', 'ring-secondary');
+      setTimeout(() => {
+        stockForm.classList.remove('ring-2', 'ring-secondary');
+      }, 1200);
+    }
+  }
+
+  function showToast(title, msg) {
+    const toast = document.getElementById('toast-notification');
+    const toastTitle = document.getElementById('toast-title');
+    const toastMsg = document.getElementById('toast-msg');
+    if (toast && toastTitle && toastMsg) {
+      toastTitle.textContent = title;
+      toastMsg.textContent = msg;
+      toast.classList.remove('hidden');
+      setTimeout(() => {
+        toast.classList.add('hidden');
+      }, 4000);
+    }
+  }
+
+  function submitStockIn() {
+    const selectedMat = materialSelect ? materialSelect.options[materialSelect.selectedIndex].text : 'NguyÃªn liá»‡u';
+    const qty = qtyInput ? qtyInput.value : 0;
+    showToast('ÄÃ£ Nháº­p Kho ThÃ nh CÃ´ng!', `ÄÃ£ cá»™ng thÃªm +${qty} Ä‘Æ¡n vá»‹ cho máº·t hÃ ng: ${selectedMat.split('-')[1] || selectedMat}`);
+  }
+
+  function recalculateVariance() {
+    showToast('ÄÃ£ Äá»‘i SoÃ¡t Dá»¯ Liá»‡u!', 'Há»‡ thá»‘ng Ä‘Ã£ cáº­p nháº­t tá»· lá»‡ hao há»¥t pha cháº¿ theo khá»‘i lÆ°á»£ng vá»«a cÃ¢n.');
+  }
+
+  function confirmShiftAudit() {
+    showToast('ÄÃ£ Chá»‘t BiÃªn Báº£n Ca!', 'BiÃªn báº£n kiá»ƒm kÃª hao há»¥t Ä‘Ã£ lÆ°u vÃ  gá»­i Ä‘áº¿n quáº£n trá»‹ viÃªn chi nhÃ¡nh Cáº©m Lá»‡.');
+  }
+
+  // Interactive Recipe Selector
+  const recipeSelector = document.getElementById('select-recipe');
+  if (recipeSelector) {
+    recipeSelector.addEventListener('change', function(e) {
+      showToast('ÄÃ£ táº£i cÃ´ng thá»©c!', 'Hiá»ƒn thá»‹ chi tiáº¿t BOM vÃ  biÃªn lá»£i nhuáº­n cho: ' + e.target.value);
+    });
+  }
+
+  // Inventory Table search filtering
+  const searchInput = document.getElementById('inventory-search');
+  if (searchInput) {
+    searchInput.addEventListener('input', function(e) {
+      const query = e.target.value.toLowerCase();
+      const rows = document.querySelectorAll('#inventory-table-body tr');
+      rows.forEach(row => {
+        const text = row.textContent.toLowerCase();
+        row.style.display = text.includes(query) ? '' : 'none';
+      });
+    });
+  }
+</script></main></div></body></html>
